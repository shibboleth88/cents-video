[
 {
  "start": 0.16,
  "end": 2.2,
  "text": "This is the Wall of DOPEMIND,"
 },
 {
  "start": 2.4,
  "end": 4.68,
  "text": "newly claimed on cents.vision."
 },
 {
  "start": 5.025,
  "end": 5.92,
  "text": "Its signature Cent"
 },
 {
  "start": 6.08,
  "end": 9.44,
  "text": "is number 478, from 1963."
 },
 {
  "start": 9.513,
  "end": 11.12,
  "text": "In the Numismatists Discord,"
 },
 {
  "start": 11.2,
  "end": 12.32,
  "text": "DOPEMIND asked:"
 },
 {
  "start": 12.4,
  "end": 14.4,
  "text": "\"What should I add to expand the set?"
 },
 {
  "start": 14.52,
  "end": 16.8,
  "text": "Wondering about the direction for this collection.\""
 },
 {
  "start": 16.88,
  "end": 18.693,
  "text": "As of November 2026,"
 },
 {
  "start": 18.747,
  "end": 23.127,
  "text": "the Wall holds 12 Cents, from 1963 to 1981."
 },
 {
  "start": 23.2,
  "end": 27.12,
  "text": "Eight carry a patina: verdigris, obsidian or desert."
 },
 {
  "start": 27.193,
  "end": 28.4,
  "text": "What it does not hold:"
 },
 {
  "start": 28.48,
  "end": 30.4,
  "text": "a red patina, a wheat penny,"
 },
 {
  "start": 30.48,
  "end": 33.927,
  "text": "or a Cent from 1969 or 1971."
 },
 {
  "start": 34.0,
  "end": 36.16,
  "text": "centoshi replied: \"You already know"
 },
 {
  "start": 36.24,
  "end": 39.847,
  "text": "my answer.\" DOPEMIND wrote back: \"1971.\""
 },
 {
  "start": 39.92,
  "end": 43.16,
  "text": "centoshi holds 16 Cents from 1971,"
 },
 {
  "start": 43.2,
  "end": 44.967,
  "text": "more than any other collector."
 },
 {
  "start": 45.04,
  "end": 47.627,
  "text": "Of 1971, Martin Lehnen wrote:"
 },
 {
  "start": 47.653,
  "end": 49.68,
  "text": "\"It was the year the United States abandoned"
 },
 {
  "start": 49.76,
  "end": 51.76,
  "text": "the gold standard, severing the connection"
 },
 {
  "start": 51.84,
  "end": 54.093,
  "text": "between currency and tangible value.\""
 },
 {
  "start": 54.24,
  "end": 58.2,
  "text": "A 1971 Cent would add the 1971 Club badge."
 },
 {
  "start": 58.24,
  "end": 60.027,
  "text": "With the Wall's 1979,"
 },
 {
  "start": 60.053,
  "end": 63.287,
  "text": "it would leave a Chronicle Set one 1982 short."
 },
 {
  "start": 63.36,
  "end": 65.253,
  "text": "Daidatep suggested six Cents,"
 },
 {
  "start": 65.307,
  "end": 67.687,
  "text": "and added: \"I could go on and on.\""
 },
 {
  "start": 67.76,
  "end": 71.08,
  "text": "Number 8657 is from 1965."
 },
 {
  "start": 71.12,
  "end": 73.68,
  "text": "Only 90 Cents are from 1965,"
 },
 {
  "start": 73.76,
  "end": 76.327,
  "text": "fewer than any other year of the 1960s."
 },
 {
  "start": 76.4,
  "end": 80.4,
  "text": "Number 8820, from 1972, carries red patina."
 },
 {
  "start": 80.48,
  "end": 81.947,
  "text": "With all four base patinas,"
 },
 {
  "start": 81.973,
  "end": 83.767,
  "text": "the card would add a Patina Set."
 },
 {
  "start": 83.84,
  "end": 86.693,
  "text": "Number 6451 is from 1980."
 },
 {
  "start": 86.747,
  "end": 88.347,
  "text": "With the Wall's 1981,"
 },
 {
  "start": 88.373,
  "end": 91.767,
  "text": "it would leave a 1980s Set one 1982 short."
 },
 {
  "start": 91.84,
  "end": 94.96,
  "text": "Number 6875, from 1967,"
 },
 {
  "start": 95.04,
  "end": 97.547,
  "text": "is heavily abraded, one of 44."
 },
 {
  "start": 97.573,
  "end": 98.6,
  "text": "In the Traits Atlas,"
 },
 {
  "start": 98.64,
  "end": 101.687,
  "text": "heavy abrasion \"dominates the read of the coin.\""
 },
 {
  "start": 101.76,
  "end": 105.573,
  "text": "Number 6782, a 1969 from Denver,"
 },
 {
  "start": 105.627,
  "end": 107.927,
  "text": "would add the 1969 Club badge."
 },
 {
  "start": 108.0,
  "end": 111.547,
  "text": "And number 5888, a 1956 from Denver,"
 },
 {
  "start": 111.573,
  "end": 113.705,
  "text": "would be the Wall's first wheat penny."
 },
 {
  "start": 113.975,
  "end": 115.12,
  "text": "Find all of the Collector Walls"
 },
 {
  "start": 115.2,
  "end": 117.44,
  "text": "on cents.vision under Collectors."
 },
 {
  "start": 117.68,
  "end": 119.76,
  "text": "What should DOPEMIND add next?"
 },
 {
  "start": 120.0,
  "end": 121.2,
  "text": "Tell us what you think."
 }
]