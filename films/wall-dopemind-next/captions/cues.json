[
 {
  "start": 0.08,
  "end": 1.92,
  "text": "In the Numismatists Discord,"
 },
 {
  "start": 2.08,
  "end": 3.16,
  "text": "DOPEMIND asked:"
 },
 {
  "start": 3.36,
  "end": 5.76,
  "text": "\"What should I add to expand the set?"
 },
 {
  "start": 5.84,
  "end": 8.487,
  "text": "Wondering about the direction for this collection.\""
 },
 {
  "start": 8.56,
  "end": 11.28,
  "text": "As of November 2026, DOPEMIND's Wall"
 },
 {
  "start": 11.4,
  "end": 16.647,
  "text": "on cents.vision holds 12 Cents, from 1963 to 1981."
 },
 {
  "start": 16.72,
  "end": 19.84,
  "text": "centoshi replied: \"You already know my answer.\""
 },
 {
  "start": 19.92,
  "end": 22.567,
  "text": "DOPEMIND wrote back: \"1971.\""
 },
 {
  "start": 22.64,
  "end": 25.96,
  "text": "centoshi holds 16 Cents from 1971,"
 },
 {
  "start": 26.0,
  "end": 27.847,
  "text": "more than any other collector."
 },
 {
  "start": 27.92,
  "end": 30.507,
  "text": "Of 1971, Martin Lehnen wrote:"
 },
 {
  "start": 30.533,
  "end": 32.56,
  "text": "\"It was the year the United States abandoned"
 },
 {
  "start": 32.6,
  "end": 34.72,
  "text": "the gold standard, severing the connection"
 },
 {
  "start": 34.8,
  "end": 37.207,
  "text": "between currency and tangible value.\""
 },
 {
  "start": 37.28,
  "end": 41.52,
  "text": "On November 9, 2026, three of the 362"
 },
 {
  "start": 41.56,
  "end": 44.407,
  "text": "Cents from 1971 were listed for sale."
 },
 {
  "start": 44.48,
  "end": 47.6,
  "text": "Number 2779 is a Ghost Cent with full"
 },
 {
  "start": 47.68,
  "end": 50.24,
  "text": "desert patina: pale toning that dominates"
 },
 {
  "start": 50.32,
  "end": 52.92,
  "text": "the coin and separates Lincoln from the field."
 },
 {
  "start": 52.96,
  "end": 55.047,
  "text": "Only 13 Cents are both."
 },
 {
  "start": 55.12,
  "end": 58.613,
  "text": "Number 8556, a 1971 from Denver,"
 },
 {
  "start": 58.667,
  "end": 60.4,
  "text": "is contaminated, with significant"
 },
 {
  "start": 60.48,
  "end": 63.127,
  "text": "verdigris: a major presence on the face."
 },
 {
  "start": 63.2,
  "end": 65.84,
  "text": "And number 5298 carries no visual"
 },
 {
  "start": 66.12,
  "end": 68.167,
  "text": "trait: a clean record of its year."
 },
 {
  "start": 68.24,
  "end": 70.4,
  "text": "Any one of them would add the 1971"
 },
 {
  "start": 70.48,
  "end": 72.246,
  "text": "Club badge to DOPEMIND's Wall."
 },
 {
  "start": 72.314,
  "end": 74.2,
  "text": "Daidatep suggested six more,"
 },
 {
  "start": 74.24,
  "end": 77.72,
  "text": "and added: \"I could go on and on.\" On the same day,"
 },
 {
  "start": 77.76,
  "end": 80.007,
  "text": "all six were listed for sale as well."
 },
 {
  "start": 80.08,
  "end": 83.48,
  "text": "Number 8657 is from 1965."
 },
 {
  "start": 83.52,
  "end": 86.133,
  "text": "Only 90 Cents are from 1965,"
 },
 {
  "start": 86.187,
  "end": 88.72,
  "text": "fewer than any other year of the 1960s,"
 },
 {
  "start": 88.8,
  "end": 90.567,
  "text": "and none of them carries a mint mark."
 },
 {
  "start": 90.64,
  "end": 92.6,
  "text": "It has a notable desert patina:"
 },
 {
  "start": 92.64,
  "end": 94.498,
  "text": "clearly visible, but local."
 },
 {
  "start": 94.702,
  "end": 97.08,
  "text": "Number 8820, from 1972,"
 },
 {
  "start": 97.12,
  "end": 98.6,
  "text": "carries two patinas:"
 },
 {
  "start": 98.64,
  "end": 99.893,
  "text": "verdigris along the rim,"
 },
 {
  "start": 99.947,
  "end": 102.2,
  "text": "and significant red across the face."
 },
 {
  "start": 102.24,
  "end": 105.207,
  "text": "183 Cents have significant red."
 },
 {
  "start": 105.28,
  "end": 106.88,
  "text": "On DOPEMIND's Wall, it would complete"
 },
 {
  "start": 106.96,
  "end": 110.007,
  "text": "a Patina Set: all four base patinas."
 },
 {
  "start": 110.08,
  "end": 114.44,
  "text": "Number 6451, from 1980, has significant obsidian:"
 },
 {
  "start": 114.48,
  "end": 117.24,
  "text": "dark toning that pushes the copper into shadow."
 },
 {
  "start": 117.28,
  "end": 119.24,
  "text": "220 Cents have it."
 },
 {
  "start": 119.353,
  "end": 123.0,
  "text": "Number 6875, from 1967,"
 },
 {
  "start": 123.2,
  "end": 126.32,
  "text": "is one of 44 heavily abraded Cents."
 },
 {
  "start": 126.36,
  "end": 127.52,
  "text": "In the Traits Atlas,"
 },
 {
  "start": 127.64,
  "end": 130.8,
  "text": "heavy abrasion \"dominates the read of the coin.\""
 },
 {
  "start": 130.88,
  "end": 134.88,
  "text": "Number 6782 is a 1969 from Denver,"
 },
 {
  "start": 134.92,
  "end": 137.52,
  "text": "with obsidian and significant verdigris."
 },
 {
  "start": 137.56,
  "end": 139.92,
  "text": "It would add the 1969 Club badge."
 },
 {
  "start": 140.0,
  "end": 143.68,
  "text": "And number 5888 is a 1956 from Denver,"
 },
 {
  "start": 143.8,
  "end": 145.36,
  "text": "with notable verdigris."
 },
 {
  "start": 145.52,
  "end": 149.84,
  "text": "Only 28 Cents are from 1956, 18 of them from Denver."
 },
 {
  "start": 149.88,
  "end": 151.707,
  "text": "It would be the Wall's first wheat penny."
 },
 {
  "start": 152.217,
  "end": 153.36,
  "text": "To see every Cent listed"
 },
 {
  "start": 153.44,
  "end": 155.44,
  "text": "for sale, switch cents.vision"
 },
 {
  "start": 155.52,
  "end": 156.8,
  "text": "from Lab to Market."
 },
 {
  "start": 157.2,
  "end": 158.88,
  "text": "What should DOPEMIND add next?"
 },
 {
  "start": 158.96,
  "end": 160.0,
  "text": "Tell us what you think."
 }
]