[
 {
  "start": 0.145,
  "end": 2.48,
  "text": "This is the Wall of ScrappyT."
 },
 {
  "start": 2.938,
  "end": 5.6,
  "text": "Its 41 Cents hold every one of the nineteen"
 },
 {
  "start": 5.68,
  "end": 7.2,
  "text": "traits in the Traits Atlas."
 },
 {
  "start": 7.44,
  "end": 9.36,
  "text": "As of October 2026,"
 },
 {
  "start": 9.44,
  "end": 12.12,
  "text": "no other Wall on cents.vision does."
 },
 {
  "start": 12.16,
  "end": 13.24,
  "text": "Even the artist wallet,"
 },
 {
  "start": 13.28,
  "end": 16.04,
  "text": "with a thousand Cents, has no Iridescent Cent."
 },
 {
  "start": 16.458,
  "end": 19.0,
  "text": "Its signature Cent, number 7139,"
 },
 {
  "start": 19.04,
  "end": 21.8,
  "text": "from 1967, carries two of them:"
 },
 {
  "start": 21.92,
  "end": 24.32,
  "text": "a full desert patina, and Ghost."
 },
 {
  "start": 24.4,
  "end": 26.4,
  "text": "Ghost means a full or near-full"
 },
 {
  "start": 26.52,
  "end": 29.013,
  "text": "patina sets Lincoln apart from the field."
 },
 {
  "start": 29.067,
  "end": 30.6,
  "text": "Of the thirty-three Ghost Cents,"
 },
 {
  "start": 30.64,
  "end": 33.293,
  "text": "only thirteen carry a full desert patina."
 },
 {
  "start": 33.44,
  "end": 36.247,
  "text": "Here are the other seventeen, one Cent each."
 },
 {
  "start": 36.32,
  "end": 40.807,
  "text": "Verdigris, green to teal: number 8550, significant."
 },
 {
  "start": 40.88,
  "end": 43.12,
  "text": "Obsidian, dark brown to black:"
 },
 {
  "start": 43.2,
  "end": 45.767,
  "text": "number 8394, significant."
 },
 {
  "start": 45.84,
  "end": 50.173,
  "text": "Red, scarlet to russet: number 9258, full."
 },
 {
  "start": 50.32,
  "end": 53.04,
  "text": "Notable means clearly visible but local,"
 },
 {
  "start": 53.28,
  "end": 55.32,
  "text": "significant a major presence on the face,"
 },
 {
  "start": 55.36,
  "end": 58.167,
  "text": "and full means the patina dominates the coin."
 },
 {
  "start": 58.32,
  "end": 62.487,
  "text": "Gold, honey gold to pale amber: number 5856."
 },
 {
  "start": 62.56,
  "end": 67.049,
  "text": "Orange, given only to clear standouts: number 9469."
 },
 {
  "start": 67.18,
  "end": 69.44,
  "text": "Iridescent, a copper surface overlaid"
 },
 {
  "start": 69.56,
  "end": 73.32,
  "text": "with gold, violet and blue: number 7713."
 },
 {
  "start": 73.36,
  "end": 76.487,
  "text": "Only twenty Cents carry it, and this Wall holds two."
 },
 {
  "start": 76.56,
  "end": 78.24,
  "text": "Corroded, oxidation that has"
 },
 {
  "start": 78.32,
  "end": 81.207,
  "text": "gone into the metal: number 366."
 },
 {
  "start": 81.28,
  "end": 84.887,
  "text": "Lustrous, original mint shine: number 830."
 },
 {
  "start": 84.96,
  "end": 87.36,
  "text": "Striated, parallel lines made by metal"
 },
 {
  "start": 87.48,
  "end": 90.327,
  "text": "flow during striking: number 1295."
 },
 {
  "start": 90.4,
  "end": 93.04,
  "text": "Abraded, copper missing from gouges:"
 },
 {
  "start": 93.12,
  "end": 95.773,
  "text": "number 8136, heavily abraded."
 },
 {
  "start": 95.92,
  "end": 100.093,
  "text": "Faceless, Lincoln's features lost: number 1965."
 },
 {
  "start": 100.24,
  "end": 102.0,
  "text": "Fingerprint, ridges clear enough"
 },
 {
  "start": 102.08,
  "end": 104.413,
  "text": "to read at once: number 508."
 },
 {
  "start": 104.56,
  "end": 106.187,
  "text": "White drips and streaks,"
 },
 {
  "start": 106.213,
  "end": 109.767,
  "text": "pale runs across the patina: number 2654."
 },
 {
  "start": 109.84,
  "end": 112.24,
  "text": "Contaminated, foreign matter added after"
 },
 {
  "start": 112.36,
  "end": 114.36,
  "text": "minting: four of the twelve types,"
 },
 {
  "start": 114.4,
  "end": 116.56,
  "text": "special oddities, obscure adhesive,"
 },
 {
  "start": 116.64,
  "end": 118.567,
  "text": "speckles and alien secretion."
 },
 {
  "start": 118.64,
  "end": 121.04,
  "text": "Assassin, one round mark on Lincoln's"
 },
 {
  "start": 121.12,
  "end": 123.96,
  "text": "head, neck or body: number 739."
 },
 {
  "start": 124.16,
  "end": 126.08,
  "text": "Vandalized, marks that show"
 },
 {
  "start": 126.16,
  "end": 130.32,
  "text": "deliberate human intent: number 7745."
 },
 {
  "start": 130.4,
  "end": 132.36,
  "text": "Only twenty-six Cents carry it."
 },
 {
  "start": 132.773,
  "end": 135.76,
  "text": "And Wheat, struck 1958 or earlier,"
 },
 {
  "start": 135.84,
  "end": 137.36,
  "text": "with wheat ears on the back:"
 },
 {
  "start": 137.44,
  "end": 140.64,
  "text": "number 3824, from 1956,"
 },
 {
  "start": 140.72,
  "end": 142.24,
  "text": "the earliest year on the Wall."
 },
 {
  "start": 142.56,
  "end": 144.56,
  "text": "Nineteen of nineteen."
 },
 {
  "start": 144.707,
  "end": 146.24,
  "text": "The Wall spans two wallets"
 },
 {
  "start": 146.32,
  "end": 149.36,
  "text": "and the years 1956 to 1982,"
 },
 {
  "start": 149.48,
  "end": 150.88,
  "text": "which puts it in the Quarter Club,"
 },
 {
  "start": 150.96,
  "end": 153.2,
  "text": "for twenty-five to forty-nine Cents."
 },
 {
  "start": 153.28,
  "end": 156.56,
  "text": "It completes six Sets, among them a Spectrum Set:"
 },
 {
  "start": 156.68,
  "end": 159.68,
  "text": "all four base patinas, plus gold and orange."
 },
 {
  "start": 159.72,
  "end": 162.4,
  "text": "As of October 2026, ScrappyT is one"
 },
 {
  "start": 162.44,
  "end": 165.04,
  "text": "of only fifteen collectors to hold one."
 },
 {
  "start": 165.113,
  "end": 167.04,
  "text": "The Wall carries Diamond Hands:"
 },
 {
  "start": 167.08,
  "end": 168.72,
  "text": "it has held its position for at least"
 },
 {
  "start": 168.8,
  "end": 171.04,
  "text": "a year, with little to no selling."
 },
 {
  "start": 171.12,
  "end": 173.36,
  "text": "And it is a Mint Keeper: ScrappyT"
 },
 {
  "start": 173.48,
  "end": 174.72,
  "text": "minted four of its Cents"
 },
 {
  "start": 174.8,
  "end": 177.12,
  "text": "and still holds them, never sold."
 },
 {
  "start": 177.36,
  "end": 178.8,
  "text": "Find all of the Collector Walls"
 },
 {
  "start": 178.88,
  "end": 181.36,
  "text": "on cents.vision under Collectors."
 }
]