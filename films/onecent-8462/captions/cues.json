[
 {
  "start": 0.0,
  "end": 2.415,
  "text": "Cent #8462."
 },
 {
  "start": 2.844,
  "end": 6.896,
  "text": "A penny struck in 1973, at Philadelphia."
 },
 {
  "start": 7.593,
  "end": 9.172,
  "text": "Beside Lincoln's face,"
 },
 {
  "start": 9.369,
  "end": 11.088,
  "text": "someone has engraved a rabbit."
 },
 {
  "start": 12.184,
  "end": 15.69,
  "text": "Under it, the word EASTER, just above the date."
 },
 {
  "start": 16.894,
  "end": 19.251,
  "text": "Its one trait is Vandalized."
 },
 {
  "start": 19.855,
  "end": 22.328,
  "text": "The Traits Atlas of the CENTS Trait"
 },
 {
  "start": 22.398,
  "end": 24.754,
  "text": "Council defines it as clear,"
 },
 {
  "start": 24.812,
  "end": 27.227,
  "text": "intentional, human-made deformation"
 },
 {
  "start": 27.343,
  "end": 28.795,
  "text": "or marking of the coin."
 },
 {
  "start": 29.55,
  "end": 32.696,
  "text": "The Atlas gives this Cent as its first example."
 },
 {
  "start": 33.621,
  "end": 36.86,
  "text": "26 of the 10,000 Cents carry the trait."
 },
 {
  "start": 37.464,
  "end": 42.073,
  "text": "#8462 is the only one from 1973."
 },
 {
  "start": 43.97,
  "end": 46.617,
  "text": "Compare Cent #2125,"
 },
 {
  "start": 46.942,
  "end": 51.434,
  "text": "also from 1973, whose only trait is Lustrous."
 },
 {
  "start": 51.934,
  "end": 53.873,
  "text": "The same design, the same year."
 },
 {
  "start": 54.662,
  "end": 56.334,
  "text": "Only one of them was engraved."
 },
 {
  "start": 57.724,
  "end": 59.105,
  "text": "Difference makes meaning."
 },
 {
  "start": 60.022,
  "end": 61.764,
  "text": "In the words of Steven Reiss,"
 },
 {
  "start": 61.996,
  "end": 65.362,
  "text": "in his article \"Materiality and Signification\":"
 },
 {
  "start": 66.035,
  "end": 68.138,
  "text": "\"Coins whose look strays farthest"
 },
 {
  "start": 68.184,
  "end": 70.565,
  "text": "from the norm became the most coveted."
 },
 {
  "start": 71.377,
  "end": 73.096,
  "text": "Difference now drives value -"
 },
 {
  "start": 73.27,
  "end": 74.767,
  "text": "just as Saussure said:"
 },
 {
  "start": 75.278,
  "end": 78.065,
  "text": "we understand a sign by what it is not.\""
 },
 {
  "start": 78.877,
  "end": 82.093,
  "text": "After it was photographed, this penny was melted,"
 },
 {
  "start": 82.419,
  "end": 84.252,
  "text": "with the rest of the 10,000,"
 },
 {
  "start": 84.427,
  "end": 86.133,
  "text": "into a single copper block."
 },
 {
  "start": 86.459,
  "end": 88.362,
  "text": "Its copper is in the block."
 },
 {
  "start": 88.874,
  "end": 91.207,
  "text": "Its image is inscribed on a satoshi."
 },
 {
  "start": 92.031,
  "end": 93.807,
  "text": "In the words of Martin Lehnen,"
 },
 {
  "start": 93.981,
  "end": 96.918,
  "text": "in his essay \"Rutherford Chang's Conceptual"
 },
 {
  "start": 96.988,
  "end": 99.658,
  "text": "Collecting\": \"Can destruction"
 },
 {
  "start": 99.728,
  "end": 102.63,
  "text": "create value, just as accumulation does?"
 },
 {
  "start": 103.327,
  "end": 106.171,
  "text": "If mass production standardizes objects,"
 },
 {
  "start": 106.497,
  "end": 109.91,
  "text": "can time and context reintroduce uniqueness?\""
 }
]