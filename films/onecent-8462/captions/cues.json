[
 {
  "start": 0.16,
  "end": 2.72,
  "text": "Cent #8462."
 },
 {
  "start": 3.04,
  "end": 6.32,
  "text": "A penny struck in 1973, at Philadelphia."
 },
 {
  "start": 7.12,
  "end": 8.4,
  "text": "Beside Lincoln's face,"
 },
 {
  "start": 8.48,
  "end": 10.132,
  "text": "someone has engraved a rabbit."
 },
 {
  "start": 10.82,
  "end": 13.78,
  "text": "Under it, the word EASTER, just above the date."
 },
 {
  "start": 14.54,
  "end": 16.946,
  "text": "Collectors have nicknamed it the Easter penny."
 },
 {
  "start": 17.86,
  "end": 19.54,
  "text": "This is an exemplary instance"
 },
 {
  "start": 19.62,
  "end": 21.045,
  "text": "of the Vandalized trait."
 },
 {
  "start": 21.72,
  "end": 23.8,
  "text": "The Traits Atlas of the CENTS Trait Council"
 },
 {
  "start": 23.88,
  "end": 25.8,
  "text": "defines Vandalized as clear,"
 },
 {
  "start": 25.92,
  "end": 28.04,
  "text": "intentional, human-made deformation"
 },
 {
  "start": 28.12,
  "end": 29.444,
  "text": "or marking of the coin."
 },
 {
  "start": 30.04,
  "end": 31.96,
  "text": "This was one of the hardest traits to catalog"
 },
 {
  "start": 32.04,
  "end": 34.138,
  "text": "due to the ambiguity of intentionality."
 },
 {
  "start": 34.92,
  "end": 37.535,
  "text": "The Atlas gives this Cent as its first example."
 },
 {
  "start": 38.54,
  "end": 41.422,
  "text": "26 of the 10,000 Cents carry the trait."
 },
 {
  "start": 43.78,
  "end": 44.955,
  "text": "Others carry scratches,"
 },
 {
  "start": 46.1,
  "end": 51.413,
  "text": "a drill attempt, paint, or a drawing in fine liner."
 },
 {
  "start": 52.92,
  "end": 56.665,
  "text": "#8462 is the only one from 1973."
 },
 {
  "start": 57.88,
  "end": 60.2,
  "text": "Compare Cent #2125,"
 },
 {
  "start": 60.36,
  "end": 63.8,
  "text": "also from 1973, a Cent close to mint state."
 },
 {
  "start": 63.88,
  "end": 65.893,
  "text": "The same design, the same year."
 },
 {
  "start": 66.6,
  "end": 68.178,
  "text": "Only one of them was engraved."
 },
 {
  "start": 69.34,
  "end": 70.665,
  "text": "Difference makes meaning."
 },
 {
  "start": 71.44,
  "end": 72.84,
  "text": "In the words of Steven Reiss,"
 },
 {
  "start": 72.88,
  "end": 75.72,
  "text": "in his article \"Materiality and Signification\":"
 },
 {
  "start": 75.853,
  "end": 77.48,
  "text": "\"Coins whose look strays farthest"
 },
 {
  "start": 77.56,
  "end": 79.72,
  "text": "from the norm became the most coveted."
 },
 {
  "start": 80.0,
  "end": 81.56,
  "text": "Difference now drives value -"
 },
 {
  "start": 81.64,
  "end": 82.92,
  "text": "just as Saussure said:"
 },
 {
  "start": 83.0,
  "end": 85.508,
  "text": "we understand a sign by what it is not.\""
 },
 {
  "start": 86.7,
  "end": 89.26,
  "text": "After it was photographed, this penny was melted,"
 },
 {
  "start": 89.3,
  "end": 90.7,
  "text": "with the rest of the 10,000,"
 },
 {
  "start": 90.82,
  "end": 92.46,
  "text": "into a single copper block."
 },
 {
  "start": 92.62,
  "end": 94.26,
  "text": "Its copper is in the block."
 },
 {
  "start": 94.38,
  "end": 96.646,
  "text": "Its image is inscribed on a satoshi."
 },
 {
  "start": 97.56,
  "end": 99.4,
  "text": "The copper was altered twice:"
 },
 {
  "start": 99.48,
  "end": 102.537,
  "text": "once by an unknown engraver, once by melting."
 },
 {
  "start": 103.66,
  "end": 105.02,
  "text": "In the words of Martin Lehnen,"
 },
 {
  "start": 105.06,
  "end": 107.18,
  "text": "in his essay \"Rutherford Chang's Conceptual"
 },
 {
  "start": 107.26,
  "end": 108.94,
  "text": "Collecting\": \"Can destruction"
 },
 {
  "start": 109.02,
  "end": 111.66,
  "text": "create value, just as accumulation does?"
 },
 {
  "start": 111.74,
  "end": 114.14,
  "text": "If mass production standardizes objects,"
 },
 {
  "start": 114.22,
  "end": 117.243,
  "text": "can time and context reintroduce uniqueness?\""
 },
 {
  "start": 119.02,
  "end": 122.42,
  "text": "Cent #8462, a great Cent."
 }
]