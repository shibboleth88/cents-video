[
 {
  "start": 0.16,
  "end": 2.8,
  "text": "Cent #2616."
 },
 {
  "start": 2.84,
  "end": 6.32,
  "text": "A penny struck in 1912, at Philadelphia."
 },
 {
  "start": 6.4,
  "end": 9.2,
  "text": "The only Cent from 1912 in the collection."
 },
 {
  "start": 9.24,
  "end": 11.2,
  "text": "One of 12 1/1 Years,"
 },
 {
  "start": 11.28,
  "end": 14.52,
  "text": "and one of only two before 1919."
 },
 {
  "start": 14.6,
  "end": 17.72,
  "text": "Scarcity written by survival."
 },
 {
  "start": 17.84,
  "end": 22.987,
  "text": "Among the 10,000 Cents, 21% are from before 1970."
 },
 {
  "start": 23.093,
  "end": 26.2,
  "text": "Before 1960, under 3%."
 },
 {
  "start": 26.32,
  "end": 29.28,
  "text": "Before 1950, under one."
 },
 {
  "start": 29.44,
  "end": 33.4,
  "text": "Before 1940, just 26 Cents."
 },
 {
  "start": 33.48,
  "end": 34.84,
  "text": "In the words of Martin Lehnen,"
 },
 {
  "start": 34.88,
  "end": 36.6,
  "text": "in his essay \"Reflections on Mint"
 },
 {
  "start": 36.68,
  "end": 39.08,
  "text": "Years\": \"This data reveals how quickly"
 },
 {
  "start": 39.16,
  "end": 40.84,
  "text": "scarcity accelerates the further"
 },
 {
  "start": 40.92,
  "end": 42.987,
  "text": "back in time you go.\""
 },
 {
  "start": 43.093,
  "end": 45.36,
  "text": "And of the 1/1 Years: \"These CENTS are"
 },
 {
  "start": 45.44,
  "end": 47.68,
  "text": "extraordinary anomalies with absolute"
 },
 {
  "start": 47.76,
  "end": 53.64,
  "text": "scarcity: \u20261912, and 1911 stand as singular relics.\""
 },
 {
  "start": 53.72,
  "end": 55.72,
  "text": "Its surface has turned red."
 },
 {
  "start": 55.84,
  "end": 56.72,
  "text": "Full Red."
 },
 {
  "start": 56.76,
  "end": 59.56,
  "text": "In the Traits Atlas, full means red dominates"
 },
 {
  "start": 59.6,
  "end": 63.933,
  "text": "the surface: a clearly red cent at first glance."
 },
 {
  "start": 64.067,
  "end": 65.6,
  "text": "Across Lincoln's head and shoulder,"
 },
 {
  "start": 65.64,
  "end": 67.187,
  "text": "grey-green films."
 },
 {
  "start": 67.293,
  "end": 68.64,
  "text": "Significant Verdigris."
 },
 {
  "start": 68.68,
  "end": 70.52,
  "text": "Significant means a major visual"
 },
 {
  "start": 70.6,
  "end": 74.0,
  "text": "actor, but not yet fully dominant."
 },
 {
  "start": 74.08,
  "end": 77.82,
  "text": "71 Cents are Full Red."
 },
 {
  "start": 77.98,
  "end": 79.313,
  "text": "This is the oldest."
 },
 {
  "start": 79.367,
  "end": 82.407,
  "text": "The next is from 1957."
 },
 {
  "start": 82.433,
  "end": 83.767,
  "text": "In the words of Martin Lehnen,"
 },
 {
  "start": 83.793,
  "end": 85.66,
  "text": "in his essay \"Lustrous CENTS\","
 },
 {
  "start": 85.74,
  "end": 88.22,
  "text": "transformation is \"neither singular nor"
 },
 {
  "start": 88.3,
  "end": 90.38,
  "text": "uniform, but a process that unfolds"
 },
 {
  "start": 90.46,
  "end": 93.98,
  "text": "at different speeds, in different ways.\""
 },
 {
  "start": 94.02,
  "end": 96.5,
  "text": "Coin collecting turned over."
 },
 {
  "start": 96.54,
  "end": 98.327,
  "text": "In the words of collector Dagmar:"
 },
 {
  "start": 98.353,
  "end": 100.113,
  "text": "\"Unlike traditional coin collectors,"
 },
 {
  "start": 100.167,
  "end": 102.78,
  "text": "who prefer old coins in pristine condition,"
 },
 {
  "start": 102.86,
  "end": 104.62,
  "text": "we \u201cdegens\u201d value the symbolic"
 },
 {
  "start": 104.86,
  "end": 106.7,
  "text": "decay of these fiat coins.\""
 }
]