[
 {
  "start": 0.0,
  "end": 2.136,
  "text": "Cent #2616."
 },
 {
  "start": 2.508,
  "end": 5.828,
  "text": "A penny struck in 1912, at Philadelphia."
 },
 {
  "start": 6.409,
  "end": 9.253,
  "text": "The only Cent from 1912 in the collection."
 },
 {
  "start": 9.927,
  "end": 11.993,
  "text": "Its surface has turned red."
 },
 {
  "start": 12.655,
  "end": 13.526,
  "text": "Full Red."
 },
 {
  "start": 14.443,
  "end": 17.531,
  "text": "In the Traits Atlas, full means red dominates"
 },
 {
  "start": 17.601,
  "end": 21.502,
  "text": "the surface: a clearly red cent at first glance."
 },
 {
  "start": 22.164,
  "end": 24.207,
  "text": "Across Lincoln's head and shoulder,"
 },
 {
  "start": 24.625,
  "end": 25.914,
  "text": "grey-green films."
 },
 {
  "start": 26.331,
  "end": 27.841,
  "text": "Significant Verdigris."
 },
 {
  "start": 28.201,
  "end": 29.942,
  "text": "Significant means a major visual"
 },
 {
  "start": 30.0,
  "end": 32.206,
  "text": "actor, but not yet fully dominant."
 },
 {
  "start": 33.775,
  "end": 35.667,
  "text": "71 Cents are Full Red."
 },
 {
  "start": 36.248,
  "end": 37.386,
  "text": "This is the oldest."
 },
 {
  "start": 37.874,
  "end": 40.381,
  "text": "The next is from 1957."
 },
 {
  "start": 41.833,
  "end": 44.26,
  "text": "Compare Cent #9540,"
 },
 {
  "start": 44.434,
  "end": 48.567,
  "text": "from 1911, whose only trait is Notable Obsidian."
 },
 {
  "start": 49.519,
  "end": 52.097,
  "text": "One year apart, a different surface."
 },
 {
  "start": 53.538,
  "end": 55.79,
  "text": "Scarcity written by survival."
 },
 {
  "start": 56.603,
  "end": 58.495,
  "text": "Among the 10,000 Cents,"
 },
 {
  "start": 58.82,
  "end": 61.502,
  "text": "the older the year, the fewer there are."
 },
 {
  "start": 62.083,
  "end": 64.742,
  "text": "12 years appear only once."
 },
 {
  "start": 67.321,
  "end": 69.005,
  "text": "In the words of Martin Lehnen,"
 },
 {
  "start": 69.272,
  "end": 72.418,
  "text": "in his essay \"Reflections on Mint Years\":"
 },
 {
  "start": 73.208,
  "end": 75.947,
  "text": "\"These CENTS are extraordinary anomalies"
 },
 {
  "start": 76.052,
  "end": 77.677,
  "text": "with absolute scarcity:"
 },
 {
  "start": 78.351,
  "end": 83.157,
  "text": "\u20261912, and 1911 stand as singular relics.\""
 },
 {
  "start": 84.77,
  "end": 86.511,
  "text": "Coin collecting turned over."
 },
 {
  "start": 87.208,
  "end": 89.321,
  "text": "In the words of collector Dagmar:"
 },
 {
  "start": 89.646,
  "end": 92.038,
  "text": "\"Unlike traditional coin collectors,"
 },
 {
  "start": 92.061,
  "end": 94.731,
  "text": "who prefer old coins in pristine condition,"
 },
 {
  "start": 95.172,
  "end": 97.03,
  "text": "we \u201cdegens\u201d value the symbolic"
 },
 {
  "start": 97.088,
  "end": 99.073,
  "text": "decay of these fiat coins.\""
 }
]