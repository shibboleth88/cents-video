[
 {
  "start": 0.22,
  "end": 1.94,
  "text": "Cent #10000."
 },
 {
  "start": 3.28,
  "end": 6.08,
  "text": "Its number is also how many Cents there are in all."
 },
 {
  "start": 7.14,
  "end": 9.16,
  "text": "A penny struck in 1976"
 },
 {
  "start": 9.2,
  "end": 10.12,
  "text": "with no mint mark,"
 },
 {
  "start": 10.4,
  "end": 12.36,
  "text": "generally indicating the Philadelphia mint."
 },
 {
  "start": 13.26,
  "end": 15.52,
  "text": "Cent #10000 carries two traits,"
 },
 {
  "start": 15.82,
  "end": 17.38,
  "text": "and the rarer is Assassin."
 },
 {
  "start": 18.379,
  "end": 19.76,
  "text": "The Cents came with no traits,"
 },
 {
  "start": 20.04,
  "end": 21.52,
  "text": "only a year and a mint mark."
 },
 {
  "start": 21.94,
  "end": 23.26,
  "text": "In the words of Steven Reiss,"
 },
 {
  "start": 23.36,
  "end": 26.0,
  "text": "in his article \"Materiality and Signification\":"
 },
 {
  "start": 26.36,
  "end": 28.22,
  "text": "\"The community therefore began naming"
 },
 {
  "start": 28.26,
  "end": 29.8,
  "text": "the spontaneous variations."
 },
 {
  "start": 30.2,
  "end": 31.12,
  "text": "Traits like 'Ghost',"
 },
 {
  "start": 31.48,
  "end": 33.52,
  "text": "'Faceless', or 'Assassin' were born.\""
 },
 {
  "start": 34.84,
  "end": 35.719,
  "text": "In the Traits Atlas,"
 },
 {
  "start": 35.96,
  "end": 38.02,
  "text": "Assassin is \"prominent spherical"
 },
 {
  "start": 38.08,
  "end": 41.28,
  "text": "obsidian, verdigris or contamination striking Abe's"
 },
 {
  "start": 41.34,
  "end": 42.86,
  "text": "head, neck, or torso \u2013"
 },
 {
  "start": 43.28,
  "end": 45.12,
  "text": "the mark of an imagined projectile.\""
 },
 {
  "start": 46.24,
  "end": 48.04,
  "text": "Here it is a single green spot"
 },
 {
  "start": 48.08,
  "end": 49.34,
  "text": "at the back of Lincoln's neck."
 },
 {
  "start": 50.32,
  "end": 52.14,
  "text": "42 Cents carry Assassin."
 },
 {
  "start": 53.94,
  "end": 56.04,
  "text": "Two of them were struck in 1976."
 },
 {
  "start": 57.26,
  "end": 59.28,
  "text": "The second trait is Notable Verdigris:"
 },
 {
  "start": 59.7,
  "end": 61.94,
  "text": "in the Atlas, \"localised but clearly"
 },
 {
  "start": 61.98,
  "end": 63.62,
  "text": "visible patches or films\"."
 },
 {
  "start": 64.34,
  "end": 65.68,
  "text": "On Cent #10000,"
 },
 {
  "start": 65.88,
  "end": 67.62,
  "text": "the spot itself is verdigris."
 },
 {
  "start": 68.98,
  "end": 71.26,
  "text": "Cent #1256 was struck the same"
 },
 {
  "start": 71.34,
  "end": 72.879,
  "text": "year, and is close to mint state."
 },
 {
  "start": 73.6,
  "end": 74.94,
  "text": "Its portrait is unmarked."
 },
 {
  "start": 76.02,
  "end": 78.5,
  "text": "As money, both meant exactly one cent."
 },
 {
  "start": 79.7,
  "end": 80.8,
  "text": "An open signifier."
 },
 {
  "start": 82.34,
  "end": 84.52,
  "text": "Steven Reiss again: \"Their former economic"
 },
 {
  "start": 84.6,
  "end": 86.9,
  "text": "meaning is unhooked from the object and turned"
 },
 {
  "start": 86.94,
  "end": 89.18,
  "text": "into a vessel for socially agreed value."
 },
 {
  "start": 90.14,
  "end": 92.0,
  "text": "The penny becomes an open signifier"
 },
 {
  "start": 92.08,
  "end": 93.76,
  "text": "that can point to many signifieds"
 },
 {
  "start": 93.76,
  "end": 97.22,
  "text": "- artistic, collector, historical, crypto.\""
 },
 {
  "start": 98.56,
  "end": 99.68,
  "text": "The portrait is Abraham"
 },
 {
  "start": 99.74,
  "end": 103.96,
  "text": "Lincoln, assassinated in 1865. In the Atlas,"
 },
 {
  "start": 104.24,
  "end": 106.06,
  "text": "the Assassin's \"singular placement"
 },
 {
  "start": 106.18,
  "end": 108.24,
  "text": "transforms decay into narrative\"."
 },
 {
  "start": 109.58,
  "end": 111.82,
  "text": "In 1968, long before CENTS,"
 },
 {
  "start": 112.14,
  "end": 114.04,
  "text": "Lucy Lippard and John Chandler wrote,"
 },
 {
  "start": 114.1,
  "end": 116.0,
  "text": "in their essay \"The Dematerialization"
 },
 {
  "start": 116.04,
  "end": 117.44,
  "text": "of Art\": \"What something"
 },
 {
  "start": 117.52,
  "end": 119.2,
  "text": "looks like and what it is about"
 },
 {
  "start": 119.4,
  "end": 120.94,
  "text": "may be complementary but not"
 },
 {
  "start": 120.96,
  "end": 123.48,
  "text": "necessarily (rarely) identical.\""
 },
 {
  "start": 124.8,
  "end": 128.12,
  "text": "To look at, Cent #10000 is a 1976"
 },
 {
  "start": 128.18,
  "end": 129.66,
  "text": "penny with one green spot."
 },
 {
  "start": 130.46,
  "end": 132.34,
  "text": "What it means, and what it is worth,"
 },
 {
  "start": 132.66,
  "end": 134.82,
  "text": "the people who collect CENTS keep deciding."
 },
 {
  "start": 136.38,
  "end": 139.1,
  "text": "Cent #10000, a great Cent."
 }
]