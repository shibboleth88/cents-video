[
 {
  "start": 0.24,
  "end": 1.84,
  "text": "Cent #8820."
 },
 {
  "start": 4.42,
  "end": 6.52,
  "text": "A penny struck in 1972"
 },
 {
  "start": 6.56,
  "end": 7.54,
  "text": "with no mint mark,"
 },
 {
  "start": 7.86,
  "end": 9.88,
  "text": "generally indicating the Philadelphia mint."
 },
 {
  "start": 10.7,
  "end": 12.24,
  "text": "Two patinas share its face."
 },
 {
  "start": 13.22,
  "end": 14.96,
  "text": "Significant Red: in the Traits"
 },
 {
  "start": 15.06,
  "end": 17.96,
  "text": "Atlas, red that is \"a major visual actor\","
 },
 {
  "start": 18.3,
  "end": 19.88,
  "text": "strong across several zones."
 },
 {
  "start": 20.62,
  "end": 22.6,
  "text": "183 Cents carry it."
 },
 {
  "start": 24.14,
  "end": 25.5,
  "text": "And Notable Verdigris:"
 },
 {
  "start": 25.86,
  "end": 28.76,
  "text": "\"localised but clearly visible patches or films\"."
 },
 {
  "start": 29.16,
  "end": 31.64,
  "text": "On Cent #8820 the green gathers"
 },
 {
  "start": 31.66,
  "end": 33.16,
  "text": "in the lettering and along the rim,"
 },
 {
  "start": 33.82,
  "end": 35.92,
  "text": "with grey-green patches on Lincoln's face"
 },
 {
  "start": 35.98,
  "end": 37.88,
  "text": "like daubs of paint laid by time."
 },
 {
  "start": 38.88,
  "end": 41.2,
  "text": "29 Cents carry exactly this pair,"
 },
 {
  "start": 41.48,
  "end": 42.24,
  "text": "and nothing else."
 },
 {
  "start": 43.58,
  "end": 45.16,
  "text": "Both are oxidation of copper."
 },
 {
  "start": 45.58,
  "end": 48.52,
  "text": "In the Atlas, red \"marks a transitional oxidation"
 },
 {
  "start": 48.62,
  "end": 51.22,
  "text": "phase between bright copper and darker patinas\"."
 },
 {
  "start": 52.36,
  "end": 54.38,
  "text": "Beside Cent #8653,"
 },
 {
  "start": 54.64,
  "end": 56.62,
  "text": "struck the same year and close to mint state,"
 },
 {
  "start": 56.88,
  "end": 59.36,
  "text": "you can see how far Cent #8820"
 },
 {
  "start": 59.4,
  "end": 60.74,
  "text": "had moved from bright copper."
 },
 {
  "start": 61.16,
  "end": 64.0,
  "text": "As money, the two were worth the same: one cent."
 },
 {
  "start": 65.3,
  "end": 66.58,
  "text": "Permanence and decay."
 },
 {
  "start": 67.94,
  "end": 70.46,
  "text": "Walter Benjamin, in his 1936 essay"
 },
 {
  "start": 70.64,
  "end": 71.4,
  "text": "\"The Work of Art"
 },
 {
  "start": 71.46,
  "end": 73.239,
  "text": "in the Age of Mechanical Reproduction\","
 },
 {
  "start": 73.5,
  "end": 75.14,
  "text": "wrote that the history of a work of art"
 },
 {
  "start": 75.2,
  "end": 76.98,
  "text": "includes \"the changes which it may"
 },
 {
  "start": 77.02,
  "end": 79.36,
  "text": "have suffered in physical condition over the years"
 },
 {
  "start": 79.54,
  "end": 81.82,
  "text": "as well as the various changes in its ownership.\""
 },
 {
  "start": 82.84,
  "end": 84.56,
  "text": "A penny is mechanically reproduced"
 },
 {
  "start": 84.58,
  "end": 86.48,
  "text": "from the start, one of billions."
 },
 {
  "start": 86.78,
  "end": 89.98,
  "text": "Yet time gave Cent #8820 a history of its own."
 },
 {
  "start": 90.9,
  "end": 92.1,
  "text": "But Benjamin also wrote:"
 },
 {
  "start": 92.38,
  "end": 93.74,
  "text": "\"The presence of the original"
 },
 {
  "start": 93.78,
  "end": 96.34,
  "text": "is the prerequisite to the concept of authenticity.\""
 },
 {
  "start": 97.12,
  "end": 98.64,
  "text": "The penny itself is gone."
 },
 {
  "start": 100.38,
  "end": 101.48,
  "text": "Through Benjamin's lens,"
 },
 {
  "start": 101.76,
  "end": 103.8,
  "text": "CENTS keeps both halves of that history:"
 },
 {
  "start": 104.08,
  "end": 105.52,
  "text": "the photograph keeps the changes"
 },
 {
  "start": 105.56,
  "end": 106.58,
  "text": "in physical condition,"
 },
 {
  "start": 106.82,
  "end": 109.04,
  "text": "and Bitcoin's ledger records each transfer"
 },
 {
  "start": 109.1,
  "end": 110.92,
  "text": "of the satoshi that carries its image."
 },
 {
  "start": 112.22,
  "end": 114.94,
  "text": "Cent #8820, a great Cent."
 }
]