[
 {
  "start": 0.0,
  "end": 2.08,
  "text": "This is the Wall of Daidatep."
 },
 {
  "start": 2.56,
  "end": 3.92,
  "text": "Its signature Cent,"
 },
 {
  "start": 4.04,
  "end": 8.16,
  "text": "number 9908, was struck in 1956,"
 },
 {
  "start": 8.24,
  "end": 10.24,
  "text": "carries a full desert patina,"
 },
 {
  "start": 10.32,
  "end": 12.48,
  "text": "is Faceless, and is contaminated"
 },
 {
  "start": 12.56,
  "end": 13.92,
  "text": "with Special Oddities."
 },
 {
  "start": 14.48,
  "end": 20.0,
  "text": "The Wall holds 132 Cents, from 1944 to 1982,"
 },
 {
  "start": 20.08,
  "end": 21.12,
  "text": "which puts it in the Dollar"
 },
 {
  "start": 21.2,
  "end": 23.2,
  "text": "Club, for a hundred Cents or more."
 },
 {
  "start": 23.68,
  "end": 25.28,
  "text": "Ten of them are wheat pennies,"
 },
 {
  "start": 25.4,
  "end": 27.44,
  "text": "minted 1958 or earlier,"
 },
 {
  "start": 27.56,
  "end": 29.68,
  "text": "with two ears of wheat on the back."
 },
 {
  "start": 29.72,
  "end": 32.24,
  "text": "The earliest is from 1944."
 },
 {
  "start": 32.32,
  "end": 37.04,
  "text": "It holds four Cents from 1971 and four from 1969,"
 },
 {
  "start": 37.12,
  "end": 40.88,
  "text": "for the 1971 Club and the 1969 Club."
 },
 {
  "start": 40.96,
  "end": 43.44,
  "text": "Cent number 3640 is the only"
 },
 {
  "start": 43.52,
  "end": 46.64,
  "text": "Cent from 1955 with a D mint mark,"
 },
 {
  "start": 46.72,
  "end": 49.04,
  "text": "which makes it a 1/1 Mint."
 },
 {
  "start": 49.16,
  "end": 52.16,
  "text": "Four of its Cents are 1/1 Trait Combos:"
 },
 {
  "start": 52.24,
  "end": 53.68,
  "text": "each carries a pair of traits"
 },
 {
  "start": 53.76,
  "end": 55.6,
  "text": "found on no other Cent."
 },
 {
  "start": 55.68,
  "end": 57.76,
  "text": "The signature Cent is one of them."
 },
 {
  "start": 57.84,
  "end": 60.48,
  "text": "Seven of its Cents carry a full patina:"
 },
 {
  "start": 60.56,
  "end": 62.32,
  "text": "four full red, two full"
 },
 {
  "start": 62.44,
  "end": 64.72,
  "text": "obsidian and the full desert."
 },
 {
  "start": 64.8,
  "end": 67.04,
  "text": "The Wall completes five Sets."
 },
 {
  "start": 67.28,
  "end": 68.64,
  "text": "A Spectrum Set:"
 },
 {
  "start": 68.72,
  "end": 71.44,
  "text": "a significant verdigris, a full obsidian,"
 },
 {
  "start": 71.52,
  "end": 73.76,
  "text": "a full red, a full desert,"
 },
 {
  "start": 73.8,
  "end": 75.76,
  "text": "a notable gold and an orange."
 },
 {
  "start": 76.16,
  "end": 77.6,
  "text": "A Chronicle Set:"
 },
 {
  "start": 77.64,
  "end": 83.04,
  "text": "a Cent from 1971, from 1979 and from 1982."
 },
 {
  "start": 83.12,
  "end": 84.64,
  "text": "A Full Mint Set:"
 },
 {
  "start": 84.72,
  "end": 88.36,
  "text": "an S mint, a D mint and a Cent with no mint mark."
 },
 {
  "start": 88.56,
  "end": 91.28,
  "text": "Its S mint is from 1945."
 },
 {
  "start": 91.36,
  "end": 93.12,
  "text": "A Three Decades Set:"
 },
 {
  "start": 93.2,
  "end": 95.28,
  "text": "every mint year of the 1960s,"
 },
 {
  "start": 95.36,
  "end": 98.24,
  "text": "the 1970s and the 1980s."
 },
 {
  "start": 98.32,
  "end": 100.72,
  "text": "And a Full Contamination Set,"
 },
 {
  "start": 100.8,
  "end": 103.12,
  "text": "all twelve contamination types:"
 },
 {
  "start": 103.32,
  "end": 106.56,
  "text": "paint, glue, sea salt, scotch tape,"
 },
 {
  "start": 106.72,
  "end": 109.04,
  "text": "dark grime, obscure adhesive,"
 },
 {
  "start": 109.24,
  "end": 111.04,
  "text": "blood, unknown liquid,"
 },
 {
  "start": 111.16,
  "end": 113.2,
  "text": "3D black, speckles,"
 },
 {
  "start": 113.4,
  "end": 116.16,
  "text": "alien secretion and special oddities."
 },
 {
  "start": 116.24,
  "end": 119.12,
  "text": "As of October 2026, Daidatep is one"
 },
 {
  "start": 119.2,
  "end": 120.96,
  "text": "of only two collectors to hold"
 },
 {
  "start": 121.04,
  "end": 124.0,
  "text": "one of these rare Full Contamination Sets."
 },
 {
  "start": 124.08,
  "end": 126.32,
  "text": "The Wall carries Diamond Hands:"
 },
 {
  "start": 126.4,
  "end": 128.08,
  "text": "it has held its position for at least"
 },
 {
  "start": 128.12,
  "end": 130.56,
  "text": "a year, with little to no selling."
 },
 {
  "start": 130.72,
  "end": 132.88,
  "text": "And it is a Mint Keeper: Daidatep"
 },
 {
  "start": 133.0,
  "end": 135.52,
  "text": "minted Cent number 845 and still"
 },
 {
  "start": 135.6,
  "end": 137.68,
  "text": "holds it, never sold."
 },
 {
  "start": 137.84,
  "end": 139.2,
  "text": "Find all of the Collector Walls"
 },
 {
  "start": 139.28,
  "end": 141.92,
  "text": "on cents.vision under Collectors."
 }
]