[
 {
  "start": 0.22,
  "end": 3.48,
  "text": "This is the Wall of DOPEMIND. Its signature"
 },
 {
  "start": 3.64,
  "end": 7.26,
  "text": "Cent, number 478, was struck in 1963."
 },
 {
  "start": 7.74,
  "end": 9.94,
  "text": "It carries a significant obsidian patina,"
 },
 {
  "start": 10.22,
  "end": 11.5,
  "text": "a notable desert patina,"
 },
 {
  "start": 11.76,
  "end": 13.5,
  "text": "and Speckles, small particles"
 },
 {
  "start": 13.54,
  "end": 14.78,
  "text": "scattered across the face."
 },
 {
  "start": 15.28,
  "end": 17.5,
  "text": "Notable means clearly visible but local,"
 },
 {
  "start": 17.74,
  "end": 20.24,
  "text": "and significant a major presence on the face."
 },
 {
  "start": 20.76,
  "end": 22.0,
  "text": "Speckles is one of the twelve"
 },
 {
  "start": 22.08,
  "end": 23.28,
  "text": "types of contamination,"
 },
 {
  "start": 23.6,
  "end": 25.3,
  "text": "foreign matter added after minting."
 },
 {
  "start": 25.66,
  "end": 27.42,
  "text": "Ninety-five Cents carry Speckles."
 },
 {
  "start": 27.74,
  "end": 29.62,
  "text": "Obsidian is on fewer than one in five"
 },
 {
  "start": 29.74,
  "end": 32.02,
  "text": "Cents, but on seventy of these ninety-five."
 },
 {
  "start": 32.4,
  "end": 34.54,
  "text": "Only five pair Speckles with significant"
 },
 {
  "start": 34.6,
  "end": 37.18,
  "text": "obsidian, and number 478 is the only"
 },
 {
  "start": 37.24,
  "end": 38.56,
  "text": "one of them with desert as well."
 },
 {
  "start": 38.96,
  "end": 41.56,
  "text": "No other Cent of the 10,000 carries all three."
 },
 {
  "start": 42.06,
  "end": 44.84,
  "text": "Number 8741, from 1979,"
 },
 {
  "start": 45.02,
  "end": 46.64,
  "text": "one of the three Chronicle Set years,"
 },
 {
  "start": 46.84,
  "end": 48.34,
  "text": "carries two more types at once:"
 },
 {
  "start": 48.72,
  "end": 49.96,
  "text": "paint, a colored layer,"
 },
 {
  "start": 50.3,
  "end": 53.2,
  "text": "and obscure adhesive, thick, cloudy deposits."
 },
 {
  "start": 53.56,
  "end": 54.8,
  "text": "Together, these two Cents"
 },
 {
  "start": 54.88,
  "end": 56.42,
  "text": "cover three of the twelve types,"
 },
 {
  "start": 56.54,
  "end": 58.02,
  "text": "which makes a Contamination Set."
 },
 {
  "start": 58.34,
  "end": 59.86,
  "text": "As of November 2026,"
 },
 {
  "start": 60.08,
  "end": 61.62,
  "text": "fifty-eight collectors hold one."
 },
 {
  "start": 62.0,
  "end": 63.9,
  "text": "DOPEMIND holds only two contaminated"
 },
 {
  "start": 63.98,
  "end": 66.34,
  "text": "Cents, the fewest of any Wall with this Set."
 },
 {
  "start": 66.64,
  "end": 68.62,
  "text": "Only thirteen of the 10,000 Cents"
 },
 {
  "start": 68.72,
  "end": 70.26,
  "text": "carry two types of contamination"
 },
 {
  "start": 70.3,
  "end": 73.1,
  "text": "at once, and number 8741 is one of them."
 },
 {
  "start": 73.56,
  "end": 77.36,
  "text": "The Wall holds twelve Cents, from 1963 to 1981,"
 },
 {
  "start": 77.54,
  "end": 78.9,
  "text": "which puts it in the Dime Club,"
 },
 {
  "start": 79.04,
  "end": 80.54,
  "text": "for ten to twenty-four Cents."
 },
 {
  "start": 80.92,
  "end": 82.32,
  "text": "Two of them carry a D mint"
 },
 {
  "start": 82.42,
  "end": 84.64,
  "text": "mark, for Denver, from 1963"
 },
 {
  "start": 84.66,
  "end": 85.78,
  "text": "and 1974."
 },
 {
  "start": 86.16,
  "end": 87.28,
  "text": "The Wall holds both years"
 },
 {
  "start": 87.32,
  "end": 88.54,
  "text": "without a mint mark as well."
 },
 {
  "start": 88.92,
  "end": 92.46,
  "text": "Number 3396, from 1976, carries white"
 },
 {
  "start": 92.56,
  "end": 95.32,
  "text": "drips and streaks, pale runs across the patina."
 },
 {
  "start": 95.7,
  "end": 97.12,
  "text": "Eighty-two Cents carry them."
 },
 {
  "start": 97.5,
  "end": 99.2,
  "text": "And the Wall carries Diamond Hands:"
 },
 {
  "start": 99.52,
  "end": 101.1,
  "text": "it has held its position for at least"
 },
 {
  "start": 101.16,
  "end": 103.7,
  "text": "a year, with little to no selling. DOPEMIND"
 },
 {
  "start": 103.74,
  "end": 105.18,
  "text": "has also written about CENTS:"
 },
 {
  "start": 105.64,
  "end": 106.98,
  "text": "\"Mass-produced objects become"
 },
 {
  "start": 107.04,
  "end": 108.36,
  "text": "unique through circulation."
 },
 {
  "start": 108.74,
  "end": 110.64,
  "text": "Meaning doesn't come from rarity alone."
 },
 {
  "start": 110.88,
  "end": 112.04,
  "text": "It emerges from time,"
 },
 {
  "start": 112.3,
  "end": 114.26,
  "text": "wear, and accumulated human use."
 },
 {
  "start": 114.68,
  "end": 116.12,
  "text": "Value is not invented."
 },
 {
  "start": 116.4,
  "end": 118.0,
  "text": "It is lived into existence.\""
 },
 {
  "start": 118.58,
  "end": 121.36,
  "text": "And: \"Bitcoin was the defining conceptual"
 },
 {
  "start": 121.5,
  "end": 122.86,
  "text": "artwork of the networked era,"
 },
 {
  "start": 123.3,
  "end": 125.96,
  "text": "authored by cypherpunks, executed in code."
 },
 {
  "start": 126.5,
  "end": 128.06,
  "text": "CENTS answers it materially,"
 },
 {
  "start": 128.52,
  "end": 130.479,
  "text": "fixing that abstraction into history.\""
 },
 {
  "start": 131.06,
  "end": 132.58,
  "text": "Find all of the Collector Walls"
 },
 {
  "start": 132.62,
  "end": 134.84,
  "text": "on cents.vision under Collectors."
 }
]