[
 {
  "start": 0.08,
  "end": 2.56,
  "text": "The story of the value discrepancy at the core"
 },
 {
  "start": 2.6,
  "end": 6.435,
  "text": "of CENTS is told in the traits of Cent #1264."
 },
 {
  "start": 7.547,
  "end": 9.36,
  "text": "The starting point for Rutherford Chang,"
 },
 {
  "start": 9.44,
  "end": 11.12,
  "text": "the fact that the copper in one penny"
 },
 {
  "start": 11.2,
  "end": 13.68,
  "text": "was worth about 3 times as much as a penny,"
 },
 {
  "start": 13.8,
  "end": 16.0,
  "text": "has roots and implications that are activated"
 },
 {
  "start": 16.04,
  "end": 18.423,
  "text": "by the system that he created with CENTS."
 },
 {
  "start": 19.28,
  "end": 21.88,
  "text": "In July 1944, at Bretton Woods,"
 },
 {
  "start": 21.96,
  "end": 24.52,
  "text": "44 nations tied their currencies to the US"
 },
 {
  "start": 24.6,
  "end": 26.44,
  "text": "dollar, and the dollar to gold,"
 },
 {
  "start": 26.52,
  "end": 28.28,
  "text": "at 35 dollars an ounce."
 },
 {
  "start": 28.36,
  "end": 30.22,
  "text": "Gold was the measure of money."
 },
 {
  "start": 31.02,
  "end": 34.78,
  "text": "Struck in 1944, Cent #1264 is the oldest"
 },
 {
  "start": 34.9,
  "end": 36.3,
  "text": "Cent in the collection with a gold"
 },
 {
  "start": 36.46,
  "end": 38.073,
  "text": "trait, by 12 years."
 },
 {
  "start": 38.9,
  "end": 41.94,
  "text": "On August 15, 1971, the United States"
 },
 {
  "start": 42.1,
  "end": 43.889,
  "text": "stopped exchanging dollars for gold."
 },
 {
  "start": 44.819,
  "end": 46.399,
  "text": "\"Your dollar will be worth just"
 },
 {
  "start": 46.459,
  "end": 48.059,
  "text": "as much tomorrow as it is today.\""
 },
 {
  "start": 48.949,
  "end": 50.736,
  "text": "Within two years the Bretton Woods system"
 },
 {
  "start": 50.816,
  "end": 52.256,
  "text": "had collapsed, and currencies"
 },
 {
  "start": 52.336,
  "end": 53.696,
  "text": "floated against each other."
 },
 {
  "start": 53.776,
  "end": 55.776,
  "text": "US currency became fiat:"
 },
 {
  "start": 55.856,
  "end": 57.918,
  "text": "worth what it is trusted to be worth."
 },
 {
  "start": 58.976,
  "end": 60.936,
  "text": "Significant Obsidian is covering Lincoln's"
 },
 {
  "start": 61.016,
  "end": 62.936,
  "text": "face: in the Atlas's words,"
 },
 {
  "start": 63.016,
  "end": 64.936,
  "text": "a major visual actor with strong"
 },
 {
  "start": 65.016,
  "end": 67.259,
  "text": "darkening, but not yet fully dominant."
 },
 {
  "start": 67.869,
  "end": 69.576,
  "text": "The unique form of the obsidian on this"
 },
 {
  "start": 69.656,
  "end": 72.364,
  "text": "Cent gives it its nickname: the Alien Cent."
 },
 {
  "start": 73.196,
  "end": 76.188,
  "text": "This is an object that has become alien to itself."
 },
 {
  "start": 77.396,
  "end": 78.716,
  "text": "Dislocating the global reserve"
 },
 {
  "start": 78.796,
  "end": 80.796,
  "text": "currency from any material substance"
 },
 {
  "start": 80.876,
  "end": 82.246,
  "text": "had wide-ranging effects,"
 },
 {
  "start": 83.476,
  "end": 84.916,
  "text": "not only on wealth distribution"
 },
 {
  "start": 84.996,
  "end": 85.931,
  "text": "and social equity,"
 },
 {
  "start": 86.889,
  "end": 88.588,
  "text": "but on materiality itself."
 },
 {
  "start": 91.743,
  "end": 92.996,
  "text": "These effects continue to bear"
 },
 {
  "start": 93.076,
  "end": 95.156,
  "text": "influence to this day, in economics"
 },
 {
  "start": 95.236,
  "end": 96.173,
  "text": "as well as art."
 },
 {
  "start": 97.409,
  "end": 98.836,
  "text": "In the words of Adina Glickstein,"
 },
 {
  "start": 98.876,
  "end": 101.036,
  "text": "in her article \"Never Midcurve\" for Spike"
 },
 {
  "start": 101.156,
  "end": 102.556,
  "text": "Magazine: \"Post-Bretton"
 },
 {
  "start": 102.596,
  "end": 104.609,
  "text": "Woods as much as post-internet,"
 },
 {
  "start": 104.663,
  "end": 106.356,
  "text": "hasn't contemporary art become,"
 },
 {
  "start": 106.396,
  "end": 108.423,
  "text": "if not exactly a commercial product,"
 },
 {
  "start": 108.449,
  "end": 110.74,
  "text": "the financial instrument par excellence?\""
 },
 {
  "start": 111.836,
  "end": 113.596,
  "text": "It is in the strange tension between"
 },
 {
  "start": 113.676,
  "end": 116.156,
  "text": "20th century conceptual art and 21st"
 },
 {
  "start": 116.276,
  "end": 117.969,
  "text": "century post-internet art,"
 },
 {
  "start": 118.103,
  "end": 119.436,
  "text": "between absence of an object"
 },
 {
  "start": 119.516,
  "end": 121.009,
  "text": "and digital objecthood,"
 },
 {
  "start": 121.143,
  "end": 123.596,
  "text": "between value discrepancy and speculation,"
 },
 {
  "start": 123.676,
  "end": 124.827,
  "text": "that CENTS resides."
 },
 {
  "start": 126.316,
  "end": 129.516,
  "text": "Cent #1264, a great Cent."
 }
]