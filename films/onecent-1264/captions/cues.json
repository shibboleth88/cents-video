[
 {
  "start": 0.08,
  "end": 2.4,
  "text": "The story of the value discrepancy at the core"
 },
 {
  "start": 2.48,
  "end": 6.396,
  "text": "of CENTS is told in the traits of Cent #1264."
 },
 {
  "start": 7.547,
  "end": 9.547,
  "text": "The starting point for Rutherford Chang,"
 },
 {
  "start": 9.573,
  "end": 11.2,
  "text": "the fact that the copper in one penny"
 },
 {
  "start": 11.28,
  "end": 13.88,
  "text": "was worth about 3 times as much as a penny,"
 },
 {
  "start": 13.92,
  "end": 15.6,
  "text": "has roots and implications that are"
 },
 {
  "start": 15.68,
  "end": 18.591,
  "text": "activated by the system that he created with CENTS."
 },
 {
  "start": 19.56,
  "end": 22.32,
  "text": "In July 1944, at Bretton Woods,"
 },
 {
  "start": 22.36,
  "end": 24.92,
  "text": "44 nations tied their currencies to the US"
 },
 {
  "start": 24.96,
  "end": 26.893,
  "text": "dollar, and the dollar to gold,"
 },
 {
  "start": 26.947,
  "end": 28.76,
  "text": "at 35 dollars an ounce."
 },
 {
  "start": 28.84,
  "end": 30.755,
  "text": "Gold was the measure of money."
 },
 {
  "start": 31.6,
  "end": 34.8,
  "text": "On August 15, 1971, the United States"
 },
 {
  "start": 34.96,
  "end": 36.737,
  "text": "stopped exchanging dollars for gold."
 },
 {
  "start": 37.667,
  "end": 39.247,
  "text": "\"Your dollar will be worth just"
 },
 {
  "start": 39.307,
  "end": 40.907,
  "text": "as much tomorrow as it is today.\""
 },
 {
  "start": 41.676,
  "end": 43.596,
  "text": "Within two years the Bretton Woods system"
 },
 {
  "start": 43.676,
  "end": 45.116,
  "text": "had collapsed, and currencies"
 },
 {
  "start": 45.196,
  "end": 46.676,
  "text": "floated against each other."
 },
 {
  "start": 46.716,
  "end": 48.676,
  "text": "US currency became fiat:"
 },
 {
  "start": 48.716,
  "end": 50.776,
  "text": "worth what it is trusted to be worth."
 },
 {
  "start": 51.636,
  "end": 53.076,
  "text": "Dislocating the global reserve"
 },
 {
  "start": 53.316,
  "end": 54.996,
  "text": "currency from any material substance"
 },
 {
  "start": 55.076,
  "end": 56.579,
  "text": "had wide-ranging effects,"
 },
 {
  "start": 57.783,
  "end": 59.116,
  "text": "not only on wealth distribution"
 },
 {
  "start": 59.196,
  "end": 60.142,
  "text": "and social equity,"
 },
 {
  "start": 61.089,
  "end": 62.848,
  "text": "but on materiality itself."
 },
 {
  "start": 64.616,
  "end": 65.896,
  "text": "These effects continue to bear"
 },
 {
  "start": 65.976,
  "end": 68.056,
  "text": "influence to this day, in economics"
 },
 {
  "start": 68.136,
  "end": 69.058,
  "text": "as well as art."
 },
 {
  "start": 72.336,
  "end": 73.883,
  "text": "In the words of Adina Glickstein,"
 },
 {
  "start": 73.909,
  "end": 76.016,
  "text": "in her article \"Never Midcurve\" for Spike"
 },
 {
  "start": 76.096,
  "end": 77.536,
  "text": "Magazine: \"Post-Bretton"
 },
 {
  "start": 77.576,
  "end": 79.416,
  "text": "Woods as much as post-internet,"
 },
 {
  "start": 79.456,
  "end": 81.256,
  "text": "hasn't contemporary art become,"
 },
 {
  "start": 81.296,
  "end": 83.243,
  "text": "if not exactly a commercial product,"
 },
 {
  "start": 83.269,
  "end": 85.566,
  "text": "the financial instrument par excellence?\""
 },
 {
  "start": 86.736,
  "end": 88.496,
  "text": "It is in the strange tension between"
 },
 {
  "start": 88.536,
  "end": 91.056,
  "text": "20th century conceptual art and 21st"
 },
 {
  "start": 91.176,
  "end": 92.869,
  "text": "century post-internet art,"
 },
 {
  "start": 93.003,
  "end": 94.336,
  "text": "between absence of an object"
 },
 {
  "start": 94.456,
  "end": 95.989,
  "text": "and digital objecthood,"
 },
 {
  "start": 96.123,
  "end": 98.576,
  "text": "between value discrepancy and speculation,"
 },
 {
  "start": 98.656,
  "end": 99.947,
  "text": "that CENTS resides."
 },
 {
  "start": 101.608,
  "end": 104.888,
  "text": "Cent #1264, a great Cent."
 }
]